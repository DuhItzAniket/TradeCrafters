# Run npm run setup:local to generate fresh local values. Never reuse legacy credentials.
DATABASE_URL=mysql://tradecrafters:replace-me@127.0.0.1:3307/tradecrafters_v2
BETTER_AUTH_SECRET=generate-at-least-32-random-bytes
BETTER_AUTH_URL=http://127.0.0.1:3000
# Explicit local-only password accounts; this mode is rejected in production.
AUTH_DEV_CREDENTIALS=true
# Public production identity uses a registered GitHub OAuth application.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Remote MySQL must verify TLS. Set one custom CA source if required.
MYSQL_SSL=false
MYSQL_SSL_CA_FILE=
# On hosted runtimes, use the PEM certificate as a secret env var instead of a local file.
MYSQL_SSL_CA=
# Production defaults to 2 per process; local development defaults to 5.
# This does not cap aggregate connections across instances or deployments.
MYSQL_POOL_SIZE=5
# Local root env only: setup:db-identities generates this; the app uses it as DATABASE_URL.
LOCAL_RUNTIME_DATABASE_URL=
# Optional operator CLI override; never copy it into the web runtime.
OPERATOR_DATABASE_URL=
