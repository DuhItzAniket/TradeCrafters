{
  "name": "tradecrafters",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Global paper-trading laboratory",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w @tradecrafters/web",
    "build": "npm run build -w @tradecrafters/web",
    "start": "npm run start -w @tradecrafters/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @tradecrafters/web",
    "lint": "eslint apps packages scripts tests",
    "format": "prettier --write apps \"packages/*/src/**/*.ts\" \"packages/*/package.json\" scripts tests *.json *.mjs compose.yaml .github/workflows/foundation.yml",
    "format:check": "prettier --check apps \"packages/*/src/**/*.ts\" \"packages/*/package.json\" scripts tests *.json *.mjs compose.yaml .github/workflows/foundation.yml",
    "verify:source": "node scripts/verify-source.mjs",
    "test": "tsx --test tests/domain.test.ts tests/market-policy.test.ts tests/catalog.test.ts tests/fx.test.ts tests/auth-configuration.test.ts tests/trading.test.ts",
    "test:integration": "tsx --env-file=.env.local --test --test-concurrency=1 tests/integration.test.ts tests/policy-integration.test.ts tests/alias-integration.test.ts tests/catalog-integration.test.ts tests/oauth-integration.test.ts tests/database-privileges.test.ts tests/trading-integration.test.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin": "tsx --env-file=.env.local scripts/admin.ts",
    "catalog": "tsx --env-file=.env.local scripts/catalog.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:db-identities": "node --env-file=.env.local scripts/setup-db-identities.mjs",
    "legacy:server": "npm start --prefix server",
    "legacy:client": "npm start --prefix client"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "contributors": [
    "Aniket Kumar",
    "Annapurna S"
  ],
  "license": "ISC"
}
